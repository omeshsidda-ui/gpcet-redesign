# ==============================================================================
# GPCET Institutional Web Portal - Environment Variables Configuration
# ==============================================================================

# Supabase Public Configuration (Client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Secret Configuration (Server-side & Background Administrative tasks only)
# CRITICAL: Never expose this key to client bundles or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Upstash Redis Configuration (Sliding-window Rate Limiting & KV Cache)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-placeholder

# Application URL (Canonical Base URL for Metadata & Redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
