{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/api-blueprint.schema.json",
  "title": "API Design Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "context",
    "protocols",
    "domain",
    "contracts",
    "security",
    "reliability",
    "compatibility",
    "testing",
    "operations",
    "implementationPlan",
    "assumptions",
    "openQuestions"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "owner", "generatedAt"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "review", "approved", "deprecated"]},
        "owner": {"type": "string", "minLength": 1},
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceBaseline": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "required": ["purpose", "audience", "exposure", "constraints"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exposure": {"enum": ["internal", "partner", "public", "mixed"]},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "dataClassification": {"type": "array", "items": {"type": "string"}},
        "sloSummary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "role", "status", "rationale"],
        "properties": {
          "type": {"enum": ["rest", "http", "asyncapi", "graphql", "grpc", "webhook", "sse", "websocket", "other"]},
          "role": {"type": "string", "minLength": 1},
          "status": {"enum": ["primary", "secondary", "migration", "rejected"]},
          "specificationVersion": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1},
          "tradeoffs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "domain": {
      "type": "object",
      "required": ["capabilities", "resources", "invariants"],
      "properties": {
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resources": {"type": "array", "items": {"type": "object"}},
        "events": {"type": "array", "items": {"type": "object"}},
        "invariants": {"type": "array", "items": {"type": "string"}},
        "ownership": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "contracts": {
      "type": "object",
      "required": ["artifacts", "errorModel", "pagination", "idempotency"],
      "properties": {
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "errorModel": {"type": "string", "minLength": 1},
        "pagination": {"type": "string", "minLength": 1},
        "idempotency": {"type": "string", "minLength": 1},
        "concurrency": {"type": "string"},
        "longRunningOperations": {"type": "string"}
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["authentication", "authorization", "tenantIsolation", "abuseControls", "threats"],
      "properties": {
        "authentication": {"type": "object"},
        "authorization": {"type": "object"},
        "tenantIsolation": {"type": "object"},
        "abuseControls": {"type": "object"},
        "threats": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "secrets": {"type": "object"},
        "privacy": {"type": "object"}
      },
      "additionalProperties": true
    },
    "reliability": {
      "type": "object",
      "required": ["timeouts", "retries", "limits", "observability"],
      "properties": {
        "timeouts": {"type": "object"},
        "retries": {"type": "object"},
        "limits": {"type": "object"},
        "observability": {"type": "object"},
        "slo": {"type": "object"}
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": ["strategy", "breakingChangePolicy", "deprecationPolicy"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "breakingChangePolicy": {"type": "string", "minLength": 1},
        "deprecationPolicy": {"type": "string", "minLength": 1},
        "supportWindow": {"type": "string"}
      },
      "additionalProperties": true
    },
    "testing": {
      "type": "object",
      "required": ["contract", "security", "compatibility", "resilience"],
      "properties": {
        "contract": {"type": "array", "items": {"type": "string"}},
        "security": {"type": "array", "items": {"type": "string"}},
        "compatibility": {"type": "array", "items": {"type": "string"}},
        "resilience": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "object",
      "required": ["ownership", "runbooks", "releaseGates"],
      "properties": {
        "ownership": {"type": "array", "items": {"type": "string"}},
        "runbooks": {"type": "array", "items": {"type": "string"}},
        "releaseGates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "implementationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "action", "owner", "validation"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "validation": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "integer"}}
        },
        "additionalProperties": true
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "openQuestions": {"type": "array", "items": {"type": "string"}}
  }
}
