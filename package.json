{
  "name": "gpcet-redesign",
  "version": "1.0.0",
  "description": "Scraper pipeline and modern Next.js redesign for G. Pullaiah College of Engineering & Technology",
  "type": "module",
  "main": "scraper/cli.js",
  "scripts": {
    "scrape:verify": "node scraper/cli.js --verify-endpoints",
    "scrape:cache": "node scraper/cli.js --scrape-cache",
    "scrape:all": "node scraper/cli.js --scrape-all",
    "scrape:dept": "node scraper/cli.js --scrape-dept",
    "scrape:parse": "node scraper/cli.js --parse-content",
    "scrape:assets": "node scraper/cli.js --download-assets",
    "scrape:manifest": "node scraper/cli.js --generate-manifest",
    "test": "node --import tsx --test tests/",
    "test:contracts": "node scripts/test-data-contracts.js",
    "seed:generate": "node scripts/seed-supabase.js",
    "search:build": "node scripts/build-search-index.js",
    "assets:migrate": "node scripts/migrate-assets-to-supabase.js"
  },
  "keywords": [
    "gpcet",
    "scraper",
    "redesign",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "cheerio": "^1.0.0",
    "minisearch": "^7.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
